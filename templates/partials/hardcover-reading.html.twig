{% set books = hardcover_reading() %}
{% if books %}
{% if config.plugins.hardcover.built_in_css ?? true %}
  {% do assets.addCss('plugin://hardcover/css/hardcover.css') %}
{% endif %}
<section class="hc-reading" aria-labelledby="hc-reading-heading">
  <h2 id="hc-reading-heading">{{ config.plugins.hardcover.heading|default('PLUGIN_HARDCOVER.DEFAULT_HEADING'|t) }}</h2>
  <ul class="hc-reading__list">
    {% for b in books %}
    <li class="hc-book">
      {% if b.cover %}
        <img class="hc-book__cover" src="{{ b.cover }}" alt="Cover of the book '{{ b.title }}'" loading="lazy" width="80" height="120">
      {% endif %}
      <div class="hc-book__meta">
        {% if b.url %}
          <a class="hc-book__title" href="{{ b.url }}" rel="noopener">{{ b.title }}</a>
        {% else %}
          <span class="hc-book__title">{{ b.title }}</span>
        {% endif %}
        {% if b.authors %}<span class="hc-book__author">{{ b.authors|join(', ') }}</span>{% endif %}
        {% if b.progress is not null %}
          <progress class="hc-book__progress" max="100" value="{{ b.progress }}"
                    aria-label="{{ b.progress|round }}% read">{{ b.progress|round }}%</progress>
        {% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}
